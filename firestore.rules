rules_version = '2';

// SECURITY FIX: this project had no Firestore rules file at all, which means
// the database was either left in insecure "test mode" (anyone on the
// internet can read/write everything — a serious problem for a finance app,
// even a college project) or in default "locked" mode (nothing works,
// including your own app). These rules restrict every piece of data to the
// signed-in user who owns it.
//
// Deploy with: firebase deploy --only firestore:rules
// (requires the Firebase CLI: npm install -g firebase-tools, then
// `firebase login` and `firebase use smartfund-project`)
service cloud.firestore {
  match /databases/{database}/documents {

    // Everything for a given user lives under /users/{uid}/...
    // Only that authenticated user may read or write their own data.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
