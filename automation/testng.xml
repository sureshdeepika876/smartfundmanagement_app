<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SmartFund Management Enterprise E2E Test Suite" verbose="1" parallel="methods" thread-count="2">
    <listeners>
        <listener class-name="com.smartfund.listeners.TestListener"/>
    </listeners>

    <test name="Appium &amp; Selenium E2E Automation Tests">
        <classes>
            <class name="com.smartfund.tests.AuthenticationTests"/>
            <class name="com.smartfund.tests.AuthorizationAndProfileTests"/>
            <class name="com.smartfund.tests.NavigationAndDashboardTests"/>
            <class name="com.smartfund.tests.SearchFilterValidationTests"/>
        </classes>
    </test>
</suite>
